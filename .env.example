# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application
FLASK_ENV=development  # Set to 'production' for production environments
DEBUG=True # Enable/disable debug mode

# Database
DATABASE_URL=postgresql://user:password@host:port/database_name # PostgreSQL connection string

# API token (required to serve on a non-loopback address; config/docker-compose.yml
# loads this file via env_file, so set it here before `docker compose up`)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KRYPTOS_API_TOKEN=

# Runtime Configuration
PORT=5000 # Port the application will listen on
LOG_LEVEL=INFO # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# API protection (mutating routes: attack runs, reindex, decrypt, vault)
# KRYPTOS_API_TOKEN=            # required in any shared deployment
# KRYPTOS_API_AUTH=off          # local dev only: skip the token for loopback requests (ignored in production)
